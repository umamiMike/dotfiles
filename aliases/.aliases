#!/bin/sh
command -v lsd &>/dev/null && alias ls='lsd'
# alias ls='ls -lAGh'
alias al="alias | fzf"    # fuzzy list of all aliases
alias calc='bc -l'        # arbitrary-precision calculator
alias clc="fc -ln -1 | awk '{\$1=\$1}1' | xclip -selection clipboard"    # copy last shell command to clipboard

# docker ========================================================================================
if command docker &> /dev/null
then
  alias d="docker"              # docker
  alias dc="docker compose "    # docker compose
  alias dka='docker kill $(docker ps -a -q)'    # kill all running docker containers
  alias dps="docker ps"         # docker ps
fi
alias ducks='du -hcks * | sort -rn | head'    # disk usage of cwd entries, largest first
alias wild-ffrom='ff="$(fzf | xargs cat )"; echo "$ff" | fzf'    # pick a file, cat it, fzf the output

alias fswatch-ruby="fswatch -o -r --event=Created --event=Updated lib test"    # watch lib/test for ruby file changes

alias ga='git add'                # git add

alias gig='git add .gitignore && git commit -m "ignore"'    # add .gitignore and commit as "ignore"
alias gb='git branch'             # git branch
alias gc='git checkout'           # git checkout
alias gcb='git checkout -b'       # git checkout new branch
alias gca='git commit --amend'    # git commit --amend
alias gcme='git commit -m '       # git commit -m
alias gd='git diff'               # git diff
alias gdh='git diff HEAD~1'       # diff the last commit

alias gdno='git diff --name-only'                     # git diff, name-only
alias gsno='git diff --name-only --staged'            # staged files, name-only
alias gano='git status --porcelain | cut -c4-'        # all changed: staged + unstaged + untracked

alias n-gsno='nvim $(gsno | fzf)'     # open staged files
alias n-gano='nvim $(gano | fzf)'     # open any changed/untracked file
# remind what aliases and functions do
w-help() {
  {
    grep -E "^alias " ~/.aliases | sed -E "s/^alias ([^=]+)=.*#[[:space:]]*/\1  /; s/^alias ([^=]+)=.*/\1/"
    awk '
      /^#/ { sub(/^#[ \t]*/, ""); c=$0; next }
      /^(function[ \t]+)?[A-Za-z_][A-Za-z0-9_-]*[ \t]*\(\)/ {
        name=$0
        sub(/^function[ \t]+/, "", name)
        sub(/[ \t]*\(\).*/, "", name)
        print name "  " c
        c=""
        next
      }
      { c="" }
    ' ~/.aliases
  } | fzf
}

alias gl='git log'    # git log
alias glo='git log --oneline'     # git log, one line per commit

alias gp='git push'                                        # git push
alias gpo='git push origin'                                # git push origin
alias gpsu='git push --set-upstream origin $(git branch --show-current)'    # push and set upstream to current branch
alias gpob='git push origin $(git branch --show-current)'  # git push the current branch

alias gpu='git pull'    # git pull
alias gpuo='git pull origin'    # git pull origin

alias grst='git restore --staged'    # use when accidentally git added something
alias grv='git remote -v'    # git remote -v

alias gs='git status'    # git status

alias vba='. venv/bin/activate'    # activate python venv
# Git alias tab completions (bash + zsh compatible)
if [ -n "$ZSH_VERSION" ]; then
  # Wrapper approach: rewrite words array so zsh's native _git sees
  # "git <subcommand> ..." rather than the alias name, avoiding bash
  # completion functions (e.g. __git_find_on_cmdline) that fail in zsh.
  _make_git_alias_completion() {
    local alias_name="$1" subcmd="$2"
    eval "_gitcomp_${alias_name}() {
      local service=git
      curcontext=\"\${curcontext//${alias_name}/git}\"
      words=(git ${subcmd} \"\${words[@]:1}\")
      (( CURRENT++ ))
      _git
    }"
    compdef "_gitcomp_${alias_name}" "${alias_name}"
  }
  _make_git_alias_completion ga      add
  _make_git_alias_completion gig     commit
  _make_git_alias_completion gb      branch
  _make_git_alias_completion gc      checkout
  _make_git_alias_completion gcb     checkout
  _make_git_alias_completion gca     commit
  _make_git_alias_completion gcme    commit
  _make_git_alias_completion gd      diff
  _make_git_alias_completion gdno    diff
  _make_git_alias_completion gl      log
  _make_git_alias_completion glo     log
  _make_git_alias_completion gp      push
  _make_git_alias_completion gpo     push
  _make_git_alias_completion gpsu    push
  _make_git_alias_completion grst    restore
  _make_git_alias_completion grv     remote
  _make_git_alias_completion gs      status
  unfunction _make_git_alias_completion
elif [ -n "$BASH_VERSION" ]; then
  if type __git_complete &>/dev/null; then
    __git_complete ga _git_add
    __git_complete gb _git_branch
    __git_complete gc _git_checkout
    __git_complete gcb _git_checkout
    __git_complete gca _git_commit
    __git_complete gcme _git_commit
    __git_complete gd _git_diff
    __git_complete gdno _git_diff
    __git_complete gl _git_log
    __git_complete glo _git_log
    __git_complete gp _git_push
    __git_complete gpo _git_push
    __git_complete gpsu _git_push
    __git_complete grst _git_restore
    __git_complete grv _git_remote
    __git_complete gs _git_status
  fi
fi

alias hh='cat ~/.bash_history | sort | uniq | fzf'    # search bash history with fzf
alias gsls="gsutil ls | fzf | xargs gsutil ls "    # browse gsutil ls output, then list selection

