ask_ollama () {
  message="$@"
  echo "${message}"
  name="$(echo ${message:0:24} | sed s/\ /_/g).md"
  ollama run hf.co/mradermacher/git-commit-1.5B-GGUF:Q5_K_M  "${message}"  | tee -a "${name}" | glow 
}

show () {
	cat "${1}" | glow
}
