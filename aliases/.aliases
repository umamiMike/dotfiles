# elixir  ===============================================================
#
# alias mixtest="fswatch -o -r --event=Created --event=Updated lib test | mix test  --listen-on-stdin"
# watch lib/test and rerun mix test on change
function mixtest() {
  [ "$1" != "" ] && cmd="$1"  || cmd="mix test --listen-on-stdin"
  fswatch -o -r --event=Created --event=Updated lib test | eval $cmd
}

alias fselixir="fswatch -o -r --event=Created --event=Updated lib test"    # watch lib/test for file changes
# elixir related

# dealing with overloaded printout
# feeds the test in to a log file 
# and trims out everything but the first 1000 lines
function mixtesthead () {
  [ "$1" != "" ] && cmd="$1"  || cmd="mix test"
  eval "$cmd" >| runlog.ex
  sed -i '1000,$d' runlog.ex
  nvim runlog.ex
}
