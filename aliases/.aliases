# make a dir and cd into it
mkdo () {
  mkdir $1
  cd $1
}

# look up a cheat.sh page for the given topic
cheat () {
  echo "${*}"
  curl -s "https://cheat.sh/${*}?T" | cat
}
# create and open a new dated hugo post
hn () {
cd $mob/projects
logts=$(date +"%Y%m%d")
hugo new "${1}${logts}.md" &> /dev/null
nvim content/"${1}${logts}.md"
cd -
}

# open project-hub in nvim, filtered by pattern
projects () {
  cd $HOME/repos/project-hub/
  nvim -c ":FindFiles ${*}"
  cd -
}

# I liked it in elixir so I made a little convenience function for help
h () {
  $1 --help | bat
}

# print $PATH, one entry per line
paths () {
  echo $PATH | sed -r 's/\:/\n/g'
}

# make a temporary json file
tjson() { 
mktemp --suffix ".json" 
}


# open personal-journal content dir in nvim
resources () {
cd $mob/projects/content/
nvim .
cd -

}

# diff-so-fancy view of a past commit (default HEAD)
gitdiff () {
  [ $# -eq 0 ] && diffy=0 || diffy="$*"
  echo "$diffy"
  git diff HEAD~"$diffy" | diff-so-fancy | bat
}


