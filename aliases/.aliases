# open todo.md in cwd (or fd-found todo.md)
td() {
	todo_path=$(fd todo.md -1)
	[ -e  "${todo_path}" ] && nvim "${todo_path}" || nvim ./todo.md
}

# run wild-progbar.sh with args
wild-tmr() {
wild-progbar.sh $1 "$2"
}

findem() {
# TODO: figure out what this does or delete
ls *.* | entr -s "clear; rg $1 $2"
}

# open a ripgrep/fzf-picked file in nvim, with preview toggle
Files () {
  nvim "$(rg  --files |   fzf --prompt=$PWD/ \
    --preview-window='up:50%:hidden' \
    --bind 'ctrl-/:toggle-preview' \
    --bind 'ctrl-v:execute($EDITOR {})'
      )"

    }

# using ripgrep combined with preview
# find-in-file - usage: fif <searchTerm>
fif () {
  if [ ! "$#" -gt 0 ]; then echo "Need a string to search for!"; return 1; fi
  rg --files-with-matches --no-messages "$1" | fzf --preview "highlight -O ansi -l {} 2> /dev/null | rg --colors 'match:bg:yellow' --ignore-case --pretty --context 10 '$1' || rg --ignore-case --pretty --context 10 '$1' {}"
}

# alternative using ripgrep-all (rga) combined with fzf-tmux preview
# implementation below makes use of "open" on macOS, which can be replaced by other commands if needed.
# allows to search in PDFs, E-Books, Office documents, zip, tar.gz, etc. (see https://github.com/phiresky/ripgrep-all)
# find-in-file - usage: fif <searchTerm> or fif "string with spaces" or fif "regex"
fifa() {
    if [ ! "$#" -gt 0 ]; then echo "Need a string to search for!"; return 1; fi
    local file
    file="$(rg --max-count=1 --ignore-case --files-with-matches --no-messages "$@" | fzf-tmux +m --preview="rga --ignore-case --pretty --context 10 '"$@"' {}")" && open "$file"
}

# run the given command and add its output to copyq
copyq-to () {
copyq add --  "$(${*})"
}

# flatten a directory tree into a single dest dir, prefixing each filename
# with its parent dir name to avoid collisions
# usage: flatcopy <search-dir> <dest-dir> [fd-args...]
# ex: flatcopy foo new/location -e md   # foo/bar/baz.md -> new/location/bar-baz.md
flatcopy () {
  if [ "$#" -lt 2 ]; then
    echo "usage: flatcopy <search-dir> <dest-dir> [fd-args...]"
    return 1
  fi
  local search_dir="$1" dest_dir="$2"
  shift 2

  local -a matches
  while IFS= read -r file; do
    matches+=("$file")
  done < <(fd "$@" . "$search_dir")

  if [ "${#matches[@]}" -eq 0 ]; then
    echo "no matching files"
    return 1
  fi

  local file dir
  echo "The following files would be copied to $dest_dir:"
  for file in "${matches[@]}"; do
    dir=$(basename "$(dirname "$file")")
    echo "  $file -> $dest_dir/${dir}-$(basename "$file")"
  done

  printf 'Proceed? [y/N] '
  read -r confirm
  case "$confirm" in
    y|Y) ;;
    *) echo "Aborted"; return 1 ;;
  esac

  mkdir -p "$dest_dir"
  for file in "${matches[@]}"; do
    dir=$(basename "$(dirname "$file")")
    cp "$file" "$dest_dir/${dir}-$(basename "$file")"
  done
}

# watch path $1, rerun command $2 on change
watchnrun () {
 f="$1"; c="$2" &&  find $f  | entr $c $f
}

# browse aliases file with fzf
view-aliases () {
  cat ~.aliases | fzf
}

# edit aliases file in nvim, then re-source it
wild-editAliases () {
  nvim "~/.aliases"
  source "~/.aliases"
}

# open a file in the personal journal repo
wilding-journal () {
  cd "$HOME/personal-journal/personal-journal"
  nvim "$HOME/personal-journal/personal-journal/${1}"
  cd -
}

# google search restricted to reddit.com
search-on-reddit () {
  firefox "https://www.google.com/search?q=${1}+site%3Areddit.com"

}

# run a local ollama model on the prompt, log output to markdown
ask_ollama () {
  message="$@"
  echo "${message}"
  name="$(echo ${message:0:24} | sed s/\ /_/g).md"
  ollama run hf.co/mradermacher/git-commit-1.5B-GGUF:Q5_K_M  "${message}"  | tee -a "${name}" | glow 
}

# render a file with glow
show () {
	cat "${1}" | glow
}
# corpus ======================================================================================


ngrep() {
  if [ -z "$1" ]; then
    nvim -c "lua vim.schedule(function() vim.cmd('Telescope live_grep') end)"
  else
    nvim -c "lua vim.schedule(function() require('telescope.builtin').live_grep({default_text='$1'}) end)"
  fi
}


# convert markdown to pdf and open it
makepdf() { md2pdf $1; open "$(echo $1 | sed 's/\.md/\.pdf/g')"}

# pick tmux session(s) by name and kill them
tmux-kill-by-name() {tmux ls -F "#S" | fzf -m | xargs -n 1 tmux kill-session -t}


gaf() { git add $(git status -s | cut -d' ' -f3 | fzf -m) }
# open this repo's Rocket Chat channel in the browser
	#
refuge() {
  local repo="${1:-$(basename $(git rev-parse --show-toplevel 2>/dev/null))}"
  open "https://dev.rocketchat.app/refuge/${repo}" &> /dev/null ||  explorer.exe "https://dev.rocketchat.app/refuge/${repo}"
}
