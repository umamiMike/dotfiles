#!/usr/bin/env bash
# Browse media files (video/audio/image) on an rclone remote, multiselect
# with fzf, then hand the selection to rcreview for stream playback and
# rename/delete/skip review (no local save).
#
# Usage: rcplay <remote:path>

set -uo pipefail

FZF_BIND="tab:toggle+up,ctrl-a:select-all"

usage() {
  echo "Usage: rcplay <remote:path>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

for bin in rclone fzf; do
  command -v "$bin" >/dev/null || { echo "rcplay: '$bin' not found" >&2; exit 1; }
done

command -v rcreview >/dev/null || { echo "rcplay: 'rcreview' not found (expected alongside rcplay on PATH)" >&2; exit 1; }

list_or_die() {
  local __outvar="$1"; shift
  local -n __out_ref="$__outvar"
  local out_file err_file rc
  out_file=$(mktemp)
  err_file=$(mktemp)
  rclone "$@" >"$out_file" 2>"$err_file"
  rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "rcplay: rclone $1 failed (exit $rc):" >&2
    cat "$err_file" >&2
    rm -f "$out_file" "$err_file"
    exit 1
  fi
  mapfile -t __out_ref < "$out_file"
  rm -f "$out_file" "$err_file"
}

BASE="${1%/}"

full_remote_path() {
  local rel="$1"
  if [[ "$BASE" == *: ]]; then
    echo "${BASE}${rel}"
  else
    echo "${BASE}/${rel}"
  fi
}

EXTENSIONS=(mp4 mkv mov avi webm m4v mp3 flac wav ogg m4a jpg jpeg png gif webp bmp tiff heic stl)

mapfile -t SELECTED_EXT < <(printf '%s\n' "${EXTENSIONS[@]}" | fzf -m --bind "$FZF_BIND" --prompt="types> ")

if [[ ${#SELECTED_EXT[@]} -eq 0 ]]; then
  echo "No types selected." >&2
  exit 0
fi

INCLUDE_ARGS=()
for ext in "${SELECTED_EXT[@]}"; do
  INCLUDE_ARGS+=(--include "*.${ext}")
done

list_or_die ALL_PATHS lsf "$BASE" --files-only -R "${INCLUDE_ARGS[@]}"

mapfile -t FILES < <(printf '%s\n' "${ALL_PATHS[@]}" | fzf -m --bind "$FZF_BIND" --prompt="media> ")

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "No files selected." >&2
  exit 0
fi

for f in "${FILES[@]}"; do
  full_remote_path "$f"
done | rcreview
