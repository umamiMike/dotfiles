#!/usr/bin/env bash
# List and select files on an rclone remote, print the selected full remote
# paths to stdout for piping into another command (copy, move, etc.).
#
# Usage: rcfind [filter] <remote:path>

set -uo pipefail

FZF_BIND="tab:toggle+up,ctrl-a:select-all"

usage() {
  echo "Usage: rcfind [filter] <remote:path>" >&2
  exit 1
}

if [[ $# -eq 1 ]]; then
  FILTER=""
  BASE="${1%/}"
elif [[ $# -eq 2 ]]; then
  FILTER="$1"
  BASE="${2%/}"
else
  usage
fi

for bin in rclone fzf; do
  command -v "$bin" >/dev/null || { echo "rcfind: '$bin' not found" >&2; exit 1; }
done

list_or_die() {
  local __outvar="$1"; shift
  local -n __out_ref="$__outvar"
  local out_file err_file rc
  out_file=$(mktemp)
  err_file=$(mktemp)
  rclone "$@" >"$out_file" 2>"$err_file"
  rc=$?
  if [[ $rc -ne 0 ]]; then
    echo "rcfind: rclone $1 failed (exit $rc):" >&2
    cat "$err_file" >&2
    rm -f "$out_file" "$err_file"
    exit 1
  fi
  mapfile -t __out_ref < "$out_file"
  rm -f "$out_file" "$err_file"
}

full_remote_path() {
  local rel="$1"
  if [[ "$BASE" == *: ]]; then
    echo "${BASE}${rel}"
  else
    echo "${BASE}/${rel}"
  fi
}

INCLUDE_ARGS=()
if [[ -n "$FILTER" ]]; then
  INCLUDE_ARGS=(--include "*${FILTER}*")
fi

list_or_die ALL_PATHS lsf "$BASE" --files-only -R "${INCLUDE_ARGS[@]}"

if [[ ${#ALL_PATHS[@]} -eq 0 ]]; then
  echo "rcfind: no files found under $BASE" >&2
  exit 0
fi

mapfile -t SELECTED_FILES < <(printf '%s\n' "${ALL_PATHS[@]}" | fzf -m --bind "$FZF_BIND" --prompt="files> ")

if [[ ${#SELECTED_FILES[@]} -eq 0 ]]; then
  echo "rcfind: no files selected" >&2
  exit 0
fi

for f in "${SELECTED_FILES[@]}"; do
  full_remote_path "$f"
done
